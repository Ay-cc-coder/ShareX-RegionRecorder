<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RegionRecorder</AssemblyName>
    <RootNamespace>RegionRecorder</RootNamespace>
    <AssemblyTitle>ShareX Region Recorder</AssemblyTitle>
    <Description>只保留 ShareX 区域屏幕录制功能的极简录屏工具</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareX.ScreenRecordingLib\ShareX.ScreenRecordingLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\App.ico" LogicalName="RegionRecorder.Assets.App.ico" />
  </ItemGroup>

</Project>
